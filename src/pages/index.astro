---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";

const researchInterests = (await getCollection("research"))
  .sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

const updates = (await getCollection("updates"))
  .filter((update) => !update.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date, precision: "day" | "month" = "day") =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: precision === "month" ? undefined : "2-digit",
    timeZone: "UTC",
  }).format(date);
---

<BaseLayout>
  <main class="home-main">
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-copy">
        <p class="intro-label">PERSONAL BLOG</p>
        <h1 id="intro-title">{site.owner}的博客</h1>
        <p class="intro-description">{site.description}</p>
      </div>
      <img
        class="intro-portrait"
        src="/asset/portrait.jpg"
        alt={`${site.owner}的照片`}
        width="295"
        height="413"
      />
    </section>

    <p class="home-statement">站在AGI爆发的前夜，我们需要更认真的思考下一代的社会形态：如何让生产力爆发的曲线更符合社会的变革，如何带来新的分配原则和分配方式，这是智能科学的技术问题，更是社会科学的规划问题，我们希望最终实现共产主义社会，这是我们年轻人的伟大事业</p>

    {researchInterests.length > 0 && (
      <section class="research-section" id="research" aria-labelledby="research-title">
        <div class="section-heading">
          <h2 id="research-title">研究兴趣</h2>
          <span lang="en">Research Interests</span>
        </div>

        <ul class="research-list">
          {researchInterests.map((interest) => (
            <li>
              <h3>{interest.data.title}</h3>
              <p>{interest.data.description}</p>
              {interest.data.topics.length > 0 && (
                <ul class="research-keywords" aria-label={`${interest.data.title}的研究主题`}>
                  {interest.data.topics.map((keyword) => <li>{keyword}</li>)}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="post-section" id="posts" aria-labelledby="posts-title">
      <div class="section-heading">
        <h2 id="posts-title">文章</h2>
        <span>{posts.length} 篇</span>
      </div>

      {posts.length > 0 ? (
        <ol class="post-list">
          {posts.map((post) => (
            <li>
              <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
              <div>
                <h3><a href={`/notes/${post.id}/`}>{post.data.title}</a></h3>
                {post.data.description && <p>{post.data.description}</p>}
                {post.data.tags.length > 0 && (
                  <ul class="tag-list" aria-label="文章标签">
                    {post.data.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-state">还没有文章。在 <code>src/content/posts/</code> 新建一个 Markdown 文件吧。</p>
      )}
    </section>

    <section class="updates-section" id="updates" aria-labelledby="updates-title">
      <div class="section-heading">
        <h2 id="updates-title">我的动态轨迹</h2>
        <span>{updates.length} 条</span>
      </div>

      {updates.length > 0 ? (
        <ol class="timeline">
          {updates.map((update) => (
            <li>
              <time datetime={update.data.date.toISOString().slice(0, update.data.datePrecision === "month" ? 7 : 10)}>
                {formatDate(update.data.date, update.data.datePrecision)}
              </time>
              <div class="timeline-content">
                <span class="timeline-type">{update.data.type}</span>
                <h3>
                  {update.data.link ? <a href={update.data.link}>{update.data.title}</a> : update.data.title}
                </h3>
                {update.data.description && <p>{update.data.description}</p>}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-state">还没有动态。在 <code>src/content/updates/</code> 新建一个 Markdown 文件吧。</p>
      )}
    </section>
  </main>
</BaseLayout>
